{
  "family": "grass",
  "version": 1,
  "feature": "cell",
  "doc": "One cell of a field: its place on the hex grid and its ground, which is all the grass's choice depends on.",
  "fields": [
    {
      "name": "genome",
      "type": "grass_v1_genome",
      "doc": "The species."
    },
    {
      "name": "season",
      "type": "u32",
      "doc": "The time of year.",
      "enum": [
        "winter",
        "spring",
        "summer",
        "fall"
      ]
    },
    {
      "name": "q",
      "type": "i32",
      "doc": "The cell's axial coordinate."
    },
    {
      "name": "r",
      "type": "i32",
      "doc": "The cell's axial coordinate."
    },
    {
      "name": "ground",
      "type": "u32",
      "doc": "The cell's ground.",
      "enum": [
        "soil",
        "water",
        "rock",
        "sand",
        "path"
      ]
    },
    {
      "name": "moisture",
      "type": "f32",
      "doc": "The cell's moisture, 0 dry to 1 wet."
    },
    {
      "name": "seed",
      "type": "u32",
      "doc": "The world's seed: the same cell in another world chooses differently."
    }
  ]
}
