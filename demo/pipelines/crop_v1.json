{
  "kind": "pipeline",
  "name": "crop_v1",
  "state": "draft",
  "doc": "A crop field (design/planner.md, Crops): the game asks for a crop (a config entry: grain, maize, sunflowers, cabbages, lettuces, carrots, potatoes, onions, pumpkins, beans, tomatoes, grapes, lavender, flax), its lot's size, how far it has grown, the season, and how many wind groups its plants share; build sows it in rows, and the house animator moves each wind group in the gusts, so the field poses with a handful of wind computations.",
  "notes": [],
  "created_at": "2026-10-14T06:00:00Z",
  "params": [
    {
      "name": "type",
      "type": "config",
      "table": "crop_v1_types",
      "default": "wheat",
      "doc": "The crop: one entry from config/crop_v1_types/."
    },
    {
      "name": "size",
      "type": "enum",
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "doc": "Its lot: small (rect6x4), medium (rect8x6), or large (rect12x8)."
    },
    {
      "name": "growth",
      "type": "enum",
      "values": [
        "sown",
        "sprouting",
        "growing",
        "ripe",
        "harvested"
      ],
      "default": "ripe",
      "doc": "How far it has grown: sown (furrows), sprouting, growing, ripe, or harvested (stubble, and stooks of sheaves for grain)."
    },
    {
      "name": "season",
      "type": "enum",
      "values": [
        "winter",
        "spring",
        "summer",
        "fall"
      ],
      "default": "summer"
    },
    {
      "name": "wind_groups",
      "type": "u32",
      "min": 1,
      "max": 16,
      "default": 7,
      "doc": "How many wind groups its plants share: the wind is computed this many times a frame, however many plants."
    },
    {
      "name": "seed",
      "type": "u32",
      "min": 1,
      "max": 1000,
      "default": 1,
      "doc": "Which of the distinct fields."
    },
    {
      "name": "detail",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low"
      ],
      "default": "high",
      "doc": "Level of detail: thins the plants along each row (every second, every fourth) and drops their finer parts."
    },
    {
      "name": "wind_speed",
      "type": "f32",
      "min": 0,
      "max": 25,
      "default": 6,
      "unit": "m/s"
    },
    {
      "name": "wind_heading",
      "type": "f32",
      "min": 0,
      "max": 360,
      "default": 90,
      "unit": "deg",
      "doc": "Toward which the wind blows, from +Z toward +X."
    },
    {
      "name": "gust_damping",
      "type": "f32",
      "min": 0,
      "max": 1,
      "default": 0.3
    },
    {
      "name": "time",
      "type": "time",
      "default": 0,
      "unit": "s"
    }
  ],
  "stages": [
    {
      "id": "build",
      "system": "crop_build_v1",
      "input": {
        "type": "$type",
        "size": "$size",
        "growth": "$growth",
        "season": "$season",
        "wind_groups": "$wind_groups",
        "seed": "$seed",
        "detail": "$detail"
      }
    },
    {
      "id": "animate",
      "system": "house_animate_v1",
      "phase": "update",
      "input": {
        "bones": "@build.bones",
        "wind_speed": "$wind_speed",
        "wind_heading": "$wind_heading",
        "gust_damping": "$gust_damping",
        "time": "$time",
        "door_time": -1.0,
        "seed": "$seed"
      }
    }
  ],
  "draw": {
    "model": "build",
    "pose": "animate",
    "frame_m": 24,
    "conformance": {
      "radius": "radius",
      "height": "height",
      "box": {
        "min": "lot_min",
        "max": "lot_max"
      }
    },
    "guides": {
      "cells": "guide_cells",
      "tones": "guide_tones"
    },
    "footprint": {
      "radius": "footprint_radius",
      "cells": "footprint_cells",
      "lot": "cells"
    },
    "fires": {
      "points": "fire_points",
      "configs": "fire_configs",
      "lit": "fire_lit"
    }
  }
}
