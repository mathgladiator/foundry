{
  "kind": "pipeline",
  "name": "wall",
  "state": "draft",
  "doc": "A wall network (design/planner.md, Walls, fences, and gates): the game gives a kind (a config entry: a palisade, a town wall, a castle's curtain, a keep's wall, an earth bank, a brick wall) and a network on the hex grid's diagonal lattice (nodes and links along lines through opposite corners, with gates and towers), and build makes the whole wall (or one chunk of it) with its joins and its openings, reporting where its gates go (gate); the house animator sways its banners.",
  "notes": [],
  "created_at": "2026-10-13T23:30:00Z",
  "params": [
    {
      "name": "kind",
      "type": "config",
      "table": "wall_kinds",
      "default": "town_wall",
      "doc": "A kind: one entry from config/wall_kinds/."
    },
    {
      "name": "condition",
      "type": "enum",
      "values": [
        "intact",
        "ruin"
      ],
      "default": "intact",
      "doc": "Intact, or a ruin: broken down to a ragged height, its banners gone, overgrown, rubble beside it."
    },
    {
      "name": "network",
      "type": "config",
      "table": "line_networks",
      "default": "ring",
      "doc": "The network to build: an example from config/line_networks/, or the game's own (a planner's line)."
    },
    {
      "name": "chunks",
      "type": "u32",
      "min": 0,
      "max": 64,
      "default": 0,
      "doc": "How many chunks to split it into, by angle round its middle (0 or 1: all of it)."
    },
    {
      "name": "chunk",
      "type": "u32",
      "min": 0,
      "max": 63,
      "default": 0,
      "doc": "Which chunk to build."
    },
    {
      "name": "season",
      "type": "enum",
      "values": [
        "winter",
        "spring",
        "summer",
        "fall"
      ],
      "default": "summer"
    },
    {
      "name": "seed",
      "type": "u32",
      "min": 1,
      "max": 1000,
      "default": 1,
      "doc": "Which of the distinct builds."
    },
    {
      "name": "detail",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low"
      ],
      "default": "high",
      "doc": "Level of detail; the runtime picks it from distance and quality."
    },
    {
      "name": "wind_speed",
      "type": "f32",
      "min": 0,
      "max": 25,
      "default": 6,
      "unit": "m/s"
    },
    {
      "name": "wind_heading",
      "type": "f32",
      "min": 0,
      "max": 360,
      "default": 90,
      "unit": "deg",
      "doc": "Toward which the wind blows, from +Z toward +X."
    },
    {
      "name": "gust_damping",
      "type": "f32",
      "min": 0,
      "max": 1,
      "default": 0.3
    },
    {
      "name": "time",
      "type": "time",
      "default": 0,
      "unit": "s"
    }
  ],
  "stages": [
    {
      "id": "build",
      "system": "wall_build",
      "input": {
        "kind": "$kind",
        "network": "$network",
        "chunk": "$chunk",
        "chunks": "$chunks",
        "season": "$season",
        "seed": "$seed",
        "detail": "$detail",
        "condition": "$condition"
      }
    },
    {
      "id": "animate",
      "system": "house_animate",
      "phase": "update",
      "input": {
        "bones": "@build.bones",
        "wind_speed": "$wind_speed",
        "wind_heading": "$wind_heading",
        "gust_damping": "$gust_damping",
        "time": "$time",
        "door_time": -1,
        "seed": "$seed"
      }
    }
  ],
  "draw": {
    "model": "build",
    "pose": "animate",
    "frame_m": 34,
    "conformance": {
      "radius": "radius",
      "height": "height"
    },
    "guides": {
      "lines": "guide_lines",
      "colors": "guide_colors"
    },
    "places": {
      "positions": "gate_positions",
      "yaws": "gate_yaws",
      "sizes": "gate_widths"
    }
  }
}
